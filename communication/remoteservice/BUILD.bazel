load("@rules_java//java:defs.bzl", "java_library", "java_test")

#load(":deps.bzl", "DEPS")

load("//:maven_artifact.bzl", "maven_publish_jars")

ALL_DEPS = [
    "//util/common",
    "//util/future",
    "//util/bytecode",
    "//engine/core",
    "//feature/execution",
    "//feature/injection",
    "//service/provided:providedservice",
    "//communication/serialization",
    "//util/collection",
    "//communication/messaging",
] #+ DEPS

java_library(
    name = "remoteservice",
    srcs = glob(["src/main/java/**/*.java"]),
    resources = glob(["src/main/resources/**"], allow_empty = True,),
    visibility = ["//visibility:public"],
    javacopts = ["--release", "21"],
    deps = ALL_DEPS,
)

maven_publish_jars(
    name = "remoteservice_publish",
    target = ":remoteservice",
    deps = ALL_DEPS,
)
