load("//feature/configurator:feature.bzl", "feature")

feature(name = "application-bt")

load("@rules_java//java:defs.bzl", "java_library", "java_test")

load(":deps.bzl", "DEPS")

load("//:maven_artifacts.bzl", "maven_publish_jars")

ALL_DEPS = [
    "//util/common",
    "//util/collection",
    "//util/classreader",
    "//util/future",
    "//engine/core",
    "//feature/execution",
    "//feature/injection",
    "//engine/bt",
    # "//feature/simulation", # mastersimfeature has memory leak
    "//feature/monitoring/logbase",
    "//service/provided:providedservice",
    "//service/required:requiredservice",
    "//service/publish:publishservice",
    "//service/publishjetty",
    "//feature/environment",
    "//feature/monitoring/opentelemetry",
] + DEPS

java_library(
    name = "application-bt",
    srcs = glob(["src/main/java/**/*.java",]),
    resources = glob(["src/main/resources/**", "src/main/java/**/*.md", "src/main/java/**/*.png"], allow_empty = True,),
    visibility = ["//visibility:public"],
    javacopts = ["--release", "21"],
    deps = ALL_DEPS,
)

maven_publish_jars(
    name = "application-bt_publish",
    target = ":application-bt",
    deps = ALL_DEPS,
)

java_library(
    name = "bt_lib",
    srcs = glob(["src/main/java/**/*.java",]),
    resources = glob(["src/main/resources/**", "src/main/java/**/*.md", "src/main/java/**/*.png"], allow_empty = True,),
    visibility = ["//visibility:public"],
    javacopts = ["--release", "21"],
    deps = [
        "//util/common",
        "//util/collection",
        "//util/classreader",
        "//util/future",
        "//engine/core",
        "//feature/execution",
        "//feature/injection",
        "//engine/bt",
        # "//feature/simulation", # mastersimfeature has memory leak
        "//feature/monitoring/logbase",
        "//service/provided:providedservice",
        "//service/required:requiredservice",
        "//service/publish:publishservice",
        "//service/publishjetty",
        "//feature/environment",
        #"//feature/monitoring/opentelemetry",
    ] + DEPS,
)