load("//feature/configurator:feature.bzl", "feature")

feature(name = "application-bdi-service")

load("@rules_java//java:defs.bzl", "java_library", "java_test")

load(":deps.bzl", "DEPS")

load("//:maven_artifacts.bzl", "maven_publish_jars")

ALL_DEPS = [
    "//util/common",
    "//util/collection",
    "//util/future",
    "//engine/core",
    "//feature/execution",
    "//feature/injection",
    "//engine/bdi",
    "//service/provided:providedservice",
    "//service/required:requiredservice",
    "//serialization/traverser",
    "//environment/environment",
    "//application/bdi:application-bdi",
    "//application/micro:micro_lib",
] + DEPS

java_library(
    name = "application-bdi-service",
    srcs = glob(["src/main/java/**/*.java",]),
    resources = glob(["src/main/resources/**", "src/main/java/**/*.md", "src/main/java/**/*.png"], allow_empty = True,),
    visibility = ["//visibility:public"],
    javacopts = ["--release", "21"],
    deps = ALL_DEPS,
)

maven_publish_jars(
    name = "application-bdi-service_publish",
    target = ":application-bdi-service",
    deps = ALL_DEPS,
)