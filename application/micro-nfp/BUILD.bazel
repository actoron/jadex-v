
load("//feature/configurator:feature.bzl", "feature")

feature(name = "application-micro-nfp")

load("@rules_java//java:defs.bzl", "java_library", "java_test", "java_binary")

load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

load(":deps.bzl", "DEPS")

load("//:maven_artifact.bzl", "maven_publish_jars")

ALL_DEPS = [
    "//util/common",
    "//util/collection",
    "//util/classreader",
    "//util/future",
    "//engine/core",
    "//feature/execution",
    "//feature/injection",
    "//feature/result",
    #"//feature/simulation",
    #"//llm",
    "//monitoring/logbase",
    "//monitoring/log4j",
    "//monitoring/graylog",
    "//monitoring/fluentd",
    "//service/provided:providedservice",
    "//service/required:requiredservice",
    "//service/publish:publishservice",
    "//service/publishjetty",
    "//service/nfproperty",
    "//micro/lib"
] + DEPS

java_library(
    name = "micro-nfp",
    srcs = glob(["src/main/java/**/*.java",]),
    resources = glob(["src/main/resources/**", "src/main/java/**/*.md", "src/main/java/**/*.png"], allow_empty = True,),
    visibility = ["//visibility:public"],
    javacopts = ["--release", "21"],
    deps = ALL_DEPS,
)

maven_publish_jars(
    name = "application-micro-nfp_publish",
    target = ":micro-nfp",
    deps = ALL_DEPS,
)


    
