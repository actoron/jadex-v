load("//feature/configurator:feature.bzl", "feature")

feature(name = "application-bdi")

load("@rules_java//java:defs.bzl", "java_library")

load(":deps.bzl", "DEPS")

load("//:maven_artifacts.bzl", "maven_publish_jars")

ALL_DEPS = [
    "//util/common",
    "//util/collection",
    "//util/classreader",
    "//util/future",
    "//engine/core",
    "//feature/execution",
    "//feature/injection",
    "//engine/bdi",
    "//feature/environment",
] + DEPS

java_library(
    name = "application-bdi",
    srcs = glob(["src/main/java/**/*.java",]),
    resources = glob(["src/main/resources/**", "src/main/java/**/*.md", "src/main/java/**/*.png"], allow_empty = True,),
    visibility = ["//visibility:public"],
    javacopts = ["--release", "21"],
    deps = ALL_DEPS,
)

maven_publish_jars(
    name = "application-bdi_publish",
    target = ":application-bdi",
    deps = ALL_DEPS,
)