load("//feature/configurator:feature.bzl", "feature")

feature(name = "application-bpmn")

load("@rules_java//java:defs.bzl", "java_library", "java_test")

#load(":deps.bzl", "DEPS")

load("//:maven_artifacts.bzl", "maven_publish_jars")

ALL_DEPS = [
    "//util/common",
    "//util/collection",
    "//util/classreader",
    "//util/future",
    "//engine/core",
    "//feature/execution",
    "//feature/injection",
    "//engine/bpmn/engine",
    "//service/required:requiredservice",
    "//service/provided:providedservice",
    "//engine/bpmn/requiredservice:requiredservicebpmn",
    "//engine/bpmn/providedservice:providedservicebpmn",
    "//feature/environment",
] #+ DEPS

java_library(
    name = "bpmn",
    srcs = glob(["src/main/java/**/*.java"]),
    resources = glob(["src/main/resources/**", "src/main/java/**", ], allow_empty = True,),
    visibility = ["//visibility:public"],
    javacopts = ["--release", "21"],
    deps = ALL_DEPS,
)

java_test(
    name = "bpmn_test",
    srcs = glob(["src/test/java/**/*.java"]),
    main_class = "org.junit.platform.console.ConsoleLauncher",
    use_testrunner = False,
    args = [
        "--select-package", "jadex.bpmn",
        "--fail-if-no-tests",
    ],
    deps = [
        ":bpmn",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_junit_platform_junit_platform_suite_api",
    ] + ALL_DEPS,
    runtime_deps = [
        "@maven//:org_junit_jupiter_junit_jupiter_engine",
        "@maven//:org_junit_platform_junit_platform_suite_engine",
        "@maven//:org_junit_platform_junit_platform_launcher",
        "@maven//:org_junit_platform_junit_platform_console",
    ],
)

maven_publish_jars(
    name = "application-bpmn_publish",
    target = ":bpmn",
    deps = ALL_DEPS,
)
       