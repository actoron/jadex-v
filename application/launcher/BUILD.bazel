load("//feature/configurator:feature.bzl", "feature")

feature(name = "application-launcher")

load("@rules_java//java:defs.bzl", "java_library", "java_binary")

load(":deps.bzl", "DEPS")

load("//:maven_artifact.bzl", "maven_publish_jars")

ALL_DEPS = [
    "//util/common",
    "//engine/core",
    #"//application/micro",
    "//application/micro:micro_lib",
    "//application/bdi:application-bdi",
    "//application/bdi-service:application-bdi-service",
    #"//application/bt",
    "//application/bt:bt_lib",
] + DEPS

java_library(
    name = "launcher-gui",
    srcs = glob(["src/main/java/**/*.java",]),
    resources = glob(["src/main/resources/**"], allow_empty = True,),
    visibility = ["//visibility:public"],
    javacopts = ["--release", "21"],
    deps = ALL_DEPS,
)

java_binary(
    name = "launcher",
    main_class = "jadex.launcher.ApplicationLauncher",
    runtime_deps = [
        ":launcher-gui",
    ],
)

maven_publish_jars(
    name = "launcher_publish",
    target = ":launcher-gui",
    deps = ALL_DEPS,
)

