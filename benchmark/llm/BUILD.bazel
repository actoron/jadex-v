load("//feature/configurator:feature.bzl", "feature")

feature(name = "benchmark-core")

load("@rules_java//java:defs.bzl", "java_library", "java_test")

load(":deps.bzl", "DEPS")

load("//:maven_artifacts.bzl", "maven_publish_jars")

ALL_DEPS = [
    "//util/common",
    "//util/future",
    "//engine/core",
    "//feature/execution",
    "//service/provided:providedservice",
    "//service/required:requiredservice",
    "//llm",
    "//application/llm:application-llm",
    "//application/bdi:application-bdi",
] + DEPS

java_library(
    name = "benchmark-llm",
    srcs = glob(["src/main/java/**/*.java"]),
    resources = glob(["src/main/resources/**"], allow_empty = True,),
    visibility = ["//visibility:public"],
    javacopts = ["--release", "21"],
    deps = ALL_DEPS,
)

maven_publish_jars(
    name = "benchmark-llm_publish",
    target = ":benchmark-llm",
)