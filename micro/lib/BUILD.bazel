load("//feature/configurator:feature.bzl", "feature")
feature(name = "libmicro")

load("@rules_java//java:defs.bzl", "java_library", "java_test")

#load(":deps.bzl", "DEPS")

load("//:maven_artifact.bzl", "maven_publish_jars")

ALL_DEPS = [
    "//util/common",
    "//util/collection",
    "//util/classreader",
    "//util/future",
    "//engine/core",
    "//feature/execution",
    "//feature/injection",
    "//service/provided:providedservice",
    "//service/required:requiredservice",
] #+ DEPS

java_library(
    name = "lib",
    srcs = glob(["src/main/java/**/*.java",]),
    resources = glob(["src/main/resources/**"], allow_empty = True,),
    visibility = ["//visibility:public"],
    javacopts = ["--release", "21"],
    deps = ALL_DEPS,
)

maven_publish_jars(
    name = "libmicro_publish",
    target = ":lib",
    deps = ALL_DEPS,
)
