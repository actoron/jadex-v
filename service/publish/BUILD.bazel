load("//feature/configurator:feature.bzl", "feature")

feature(name = "publishservice")

load("@rules_java//java:defs.bzl", "java_library", "java_test")
load("//:maven_artifacts.bzl", "maven_publish_jars")

load(":deps.bzl", "DEPS")

ALL_DEPS = [
        "//util/common",
        "//util/future",
        "//util/collection",
        "//serialization/traverser",
        "//util/javaparser",
        "//engine/core",
        "//feature/injection",
        "//feature/execution",
        "//service/provided:providedservice",
        "//service/required:requiredservice",
        "//serialization/json",
        "//serialization/binary",
        "//communication/serialization",
    ] + DEPS

java_library(
    name = "publishservice",
    srcs = glob(["src/main/java/**/*.java"]),
    resources = glob(["src/main/resources/**"], allow_empty = True,),
    visibility = ["//visibility:public"],
    javacopts = ["--release", "21"],
    deps = ALL_DEPS,
)

java_library(
    name = "publish_test_fixtures",
    srcs = glob(["src/testFixtures/java/**/*.java"]),
    resources = glob(["src/testFixtures/resources/**"], allow_empty = True,),
    visibility = ["//visibility:public"],
    javacopts = ["--release", "21"],
    deps = [
        ":publishservice",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
    ] + ALL_DEPS,
)

maven_publish_jars(
    name = "publishservice_publish",
    target = ":publishservice",
    deps = ALL_DEPS,
)

