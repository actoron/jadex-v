load("@rules_java//java:defs.bzl", "java_library")

load(":deps.bzl", "DEPS")

load("//:maven_artifacts.bzl", "maven_publish_jars")

ALL_DEPS = [
    "//util/common",
    "//engine/core",
    "//feature/execution",
    "//util/future",
    "//feature/monitoring/logbase",
] + DEPS

java_library(
    name = "graylog",
    srcs = glob(["src/main/java/**/*.java"]),
    resources = glob(["src/main/resources/**"]),
    visibility = ["//visibility:public"],
    javacopts = ["--release", "21"],
    deps = ALL_DEPS
)

maven_publish_jars(
    name = "graylog_publish",
    target = ":graylog",
    deps = ALL_DEPS,
)
