load("@rules_java//java:defs.bzl", "java_library", "java_test")

load(":deps.bzl", "DEPS")

load("//:maven_artifacts.bzl", "maven_publish_jars")

java_library(
    name = "opentelemetry",
    srcs = glob(["src/main/java/**/*.java"]),
    resources = glob(["src/main/resources/**"]),
    visibility = ["//visibility:public"],
    javacopts = ["--release", "21"],
    deps = [
        "//util/common:common",
        "//engine/core",
        "//util/future",
        "//feature/monitoring/logbase",
    ] + DEPS
)

maven_publish_jars(
    name = "opentelemetry_publish",
    target = ":opentelemetry",
)

