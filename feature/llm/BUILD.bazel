load("@rules_java//java:defs.bzl", "java_library", "java_test")

load(":deps.bzl", "DEPS")

load("//:maven_artifacts.bzl", "maven_publish_jars")

ALL_DEPS = [
    "//util/common",
    "//util/collection",
    "//serialization/traverser",
    "//serialization/json",
    "//communication/serialization",
    "//util/classreader",
    "//util/future",
    "//feature/autostart",
    "//engine/core",
    "//feature/execution",
    "//feature/injection",
    "//feature/simulation",
    "//feature/monitoring/logbase",
    "//service/provided:providedservice",
    "//service/required:requiredservice",
    "//service/publish:publishservice",
    "//service/publishjetty"
] + DEPS

java_library(
    name = "llm",
    srcs = glob(["src/main/java/**/*.java",]),
    resources = glob(["src/main/resources/**"], allow_empty = True,),
    visibility = ["//visibility:public"],
    javacopts = ["--release", "21"],
    deps = ALL_DEPS,
)

maven_publish_jars(
    name = "llm_publish",
    target = ":llm",
    deps = ALL_DEPS,
)
