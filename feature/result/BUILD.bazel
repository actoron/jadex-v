load("@rules_java//java:defs.bzl", "java_library")

load("//:maven_artifacts.bzl", "maven_publish_jars")

ALL_DEPS = [
    "//util/common",
    "//util/future",
    "//engine/core",
] #+ DEPS

java_library(
    name = "result",
    srcs = glob(["src/main/java/**/*.java"]),
    resources = glob(["src/main/resources/**"]),
    visibility = ["//visibility:public"],
    javacopts = ["-source", "21", "-target", "21"],
    deps = ALL_DEPS,
)

maven_publish_jars(
    name = "result_publish",
    target = ":result",
    deps = ALL_DEPS,
)