load("@rules_java//java:defs.bzl", "java_library")

load(":deps.bzl", "DEPS")

load("//:maven_artifacts.bzl", "maven_publish_jars")

ALL_DEPS = [
    "//util/common",
    "//util/collection",
    "//util/future",
    "//engine/core",
    "//feature/injection",
    "//engine/bdi",
    "//util/idgenerator",

] + DEPS

java_library(
    name = "apmn",
    srcs = glob(["src/main/java/**/*.java"]),
    resources = glob(["src/main/resources/**"], allow_empty = True,),
    visibility = ["//visibility:public"],
    javacopts = ["-source", "21", "-target", "21"],
    deps = ALL_DEPS,
)

maven_publish_jars(
    name = "apmn_publish",
    target = ":apmn",
    deps = ALL_DEPS,
)


