load("//feature/configurator:feature.bzl", "feature")
feature(name = "requiredservicebpmn")

load("@rules_java//java:defs.bzl", "java_library", "java_test")

#load(":deps.bzl", "DEPS")

load("//:maven_artifacts.bzl", "maven_publish_jars")

ALL_DEPS = [
    "//util/common",
    "//util/collection",
    "//engine/core",
    "//util/future",
    "//util/javaparser",
    "//util/classreader",
    "//util/idgenerator",
    "//util/bytecode",
    "//feature/execution",
    "//engine/bpmn/model",
    "//feature/injection",
    "//communication/serialization",
    "//service/provided:providedservice",
    "//service/required:requiredservice",
    "//engine/bpmn/engine",
] #+ DEPS

java_library(
    name = "requiredservicebpmn",
    srcs = glob(["src/main/java/**/*.java"]),
    resources = glob(["src/main/resources/**"], allow_empty = True,),
    visibility = ["//visibility:public"],
    javacopts = ["-source", "21", "-target", "21"],
    deps = ALL_DEPS,
)

maven_publish_jars(
    name = "requiredservicebpmn_publish",
    target = ":requiredservicebpmn",
    deps = ALL_DEPS,
)
