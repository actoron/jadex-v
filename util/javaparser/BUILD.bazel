load("//feature/configurator:feature.bzl", "feature")

feature(
    type = "library",
)

load("@rules_java//java:defs.bzl", "java_library")

load("//:maven_artifact.bzl", "maven_publish_jars")

ALL_DEPS = [
    "//util/common",
    "//util/collection",
] #+ DEPS

java_library(
    name = "javaparser",
    srcs = glob(["src/main/java/**/*.java", "src/generated/javacc/**/*.java",
        "src/generated/jjtree/**/*.java",]),
    resources = glob(["src/main/resources/**"], allow_empty = True),
    visibility = ["//visibility:public"],
    javacopts = ["-source", "21", "-target", "21"],
    deps = ALL_DEPS,
)

maven_publish_jars(
    name = "javaparser_publish",
    target = ":javaparser",
    deps = ALL_DEPS,
)