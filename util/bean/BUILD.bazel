load("//feature/configurator:feature.bzl", "feature")

feature(type = "library",)

load("@rules_java//java:defs.bzl", "java_library")

load("//:maven_artifacts.bzl", "maven_publish_jars")

ALL_DEPS = [
    "//util/common",
]

java_library(
    name = "bean",
    srcs = glob(["src/main/java/**/*.java"]),
    resources = glob(["src/main/resources/**"], allow_empty = True,),
    visibility = ["//visibility:public"],
    javacopts = ["--release", "21"],
    deps = ALL_DEPS,
)
maven_publish_jars(
    name = "bean_publish",
    target = ":bean",
    deps = ALL_DEPS,
)