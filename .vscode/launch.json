{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Bazel Run",
      "type": "shell",
      "command": "bazel run //dein/package:target",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Bazel Run (Debug)",
      "type": "shell",
      "command": "bazel run //engine/bding:start_main -- --jvm_flags='-agentlib:jdwp=transport=dt_socket,server=y,suspend=y,address=5005'",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*Listening for transport dt_socket.*"
        }
      }
    },
  ],
  "configurations": [
    {
      "type": "java",
      "name": "SimpleCleanerAgent",
      "request": "launch",
      "mainClass": "jadex.quickstart.cleanerworld.SimpleCleanerAgent",
      "projectName": "application.bdi"
    },
    {
      "type": "java",
      "name": "Attach Jadex BDing",
      "request": "attach",
      "hostName": "localhost",
      "port": 5005,
      "sourcePaths": [
        "${workspaceFolder}"
      ],
      "projectName": "jadex-v-bazel"
    }
  ]
}